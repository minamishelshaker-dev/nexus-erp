# ========================================
# Nexus ERP - Environment Configuration
# ========================================
# Copy this file to .env and modify values
# IMPORTANT: Change all secrets before production!
# ========================================

# ========================================
# Application Settings
# ========================================
APP_NAME=Nexus ERP
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ========================================
# Security Settings (CHANGE THESE!)
# ========================================
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-MIN-32-CHARS-LONG

# JWT Settings
JWT_SECRET_KEY=CHANGE-THIS-TO-ANOTHER-SECURE-RANDOM-STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# Database Settings
# ========================================
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=CHANGE-THIS-PASSWORD
POSTGRES_DB=nexus_erp
DATABASE_URL=postgresql+asyncpg://nexus_user:CHANGE-THIS-PASSWORD@postgres:5432/nexus_erp

# Database Pool Settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ========================================
# Redis Settings
# ========================================
REDIS_URL=redis://redis:6379/0

# ========================================
# Celery Settings (Background Tasks)
# ========================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ========================================
# CORS Settings
# ========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=*

# ========================================
# Server Ports (optional override)
# ========================================
HTTP_PORT=80
HTTPS_PORT=443

# ========================================
# AI Services Configuration
# ========================================
# Enable/disable AI features
AI_ENABLED=true

# AI API Configuration (if using external AI service)
# AI_API_KEY=your-api-key-here
# AI_API_ENDPOINT=https://api.openai.com/v1

# OCR Settings
OCR_SUPPORTED_FORMATS=pdf,png,jpg,jpeg,bmp
OCR_MAX_FILE_SIZE=10485760

# ========================================
# Email Settings (Optional)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@your-domain.com
SMTP_USE_TLS=true

# ========================================
# File Storage Settings
# ========================================
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,xlsx,xls,csv

# ========================================
# Company Information (for invoices/reports)
# ========================================
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=Your Company Address
COMPANY_PHONE=+966-XX-XXX-XXXX
COMPANY_EMAIL=info@your-domain.com
COMPANY_TAX_ID=XXXXXXXXXXXX

# ========================================
# Localization Settings
# ========================================
DEFAULT_LANGUAGE=ar
DEFAULT_CURRENCY=SAR
DEFAULT_TIMEZONE=Asia/Riyadh
DATE_FORMAT=DD/MM/YYYY

# ========================================
# Feature Flags
# ========================================
ENABLE_REGISTRATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_TWO_FACTOR=false
ENABLE_AI_CHATBOT=true
ENABLE_DEMAND_FORECASTING=true
ENABLE_OCR_INVOICE_PARSING=true

# ========================================
# Monitoring (Optional)
# ========================================
# SENTRY_DSN=your-sentry-dsn
# PROMETHEUS_ENABLED=true
# PROMETHEUS_PORT=9090

# ========================================
# Backup Settings (Optional)
# ========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/app/backups
