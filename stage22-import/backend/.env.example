# Nexus ERP Environment Configuration
# =====================================

# Application
APP_NAME=Nexus ERP
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://nexus_user:nexus_password@localhost:5432/nexus_erp
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOLER_MODE=session

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ORIGIN_REGEX=
ALLOWED_HOSTS=["*.nexus-erp.com","*.vercel.app","localhost"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# OAuth2 (Optional - for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@nexus-erp.com
EMAILS_FROM_NAME=Nexus ERP

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Multi-tenancy
MULTI_TENANT_ENABLED=true
DEFAULT_TENANT_SCHEMA=public

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/nexus_erp.log
